# ──────────────────────────────────────────────────────────────────────────
# NovaNet Portal — environment variables
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ──────────────────────────────────────────────────────────────────────────

# ── App ─────────────────────────────────────────────────────────────────
# Public base URL of the deployed app (no trailing slash). Used to build
# payment callback URLs and links inside emails/notifications.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="NovaNet Portal"

# ── Database (Prisma / PostgreSQL) ─────────────────────────────────────
# Standard connection string. In production, prefer a pooled connection
# (e.g. PgBouncer, Neon, Supabase pooler, RDS Proxy).
DATABASE_URL="postgresql://novanet:novanet@localhost:5432/novanet_portal?schema=public"

# ── Auth.js (NextAuth v5) ───────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-32-byte-random-secret"
# Only needed if Auth.js can't infer the host (e.g. behind a proxy/CDN).
# AUTH_TRUST_HOST="true"

# ── Paystack ────────────────────────────────────────────────────────────
PAYSTACK_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
PAYSTACK_PUBLIC_KEY="pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# ── Flutterwave ─────────────────────────────────────────────────────────
FLUTTERWAVE_SECRET_KEY="FLWSECK_TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-X"
FLUTTERWAVE_PUBLIC_KEY="FLWPUBK_TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-X"
# The exact string configured in Flutterwave Dashboard → Settings → Webhooks
FLUTTERWAVE_SECRET_HASH="replace-with-your-dashboard-secret-hash"

# ── MikroTik RouterOS REST API ──────────────────────────────────────────
# The router must have the www-ssl (or www) service enabled and be
# reachable from wherever this app runs. See DEPLOYMENT.md for details.
MIKROTIK_HOST="10.0.0.1"
MIKROTIK_USERNAME="novanet-api"
MIKROTIK_PASSWORD="replace-with-a-strong-password"
MIKROTIK_USE_SSL="true"
# Set to "true" only for self-signed certs in trusted local networks.
MIKROTIK_ALLOW_INSECURE_TLS="true"

# ── Starlink Business/Enterprise API (placeholder integration) ─────────
# Requires a Starlink Reseller/Enterprise account with API access enabled
# under Settings → Service Accounts. Leave blank to run the network page
# in simulated-data mode. See src/lib/services/starlink.ts.
STARLINK_CLIENT_ID=""
STARLINK_CLIENT_SECRET=""
STARLINK_ACCOUNT_NUMBER=""

# ── Misc ────────────────────────────────────────────────────────────────
# Used to sign QR voucher payloads so redemption codes can't be forged.
VOUCHER_SIGNING_SECRET="replace-with-another-random-secret"
